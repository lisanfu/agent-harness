# 大脑配置：只走远端，不使用任何本地模型。
# 复制成 .env 后填写。留空则 CLI 默认用 stdio（宿主大脑，零 key）。

# 任意 OpenAI 兼容端点，注意要带 /v1 这一层，代码会自动补 /chat/completions
BRAIN_BASE_URL=
BRAIN_API_KEY=
BRAIN_MODEL=

# 超时与采样
BRAIN_TIMEOUT_MS=60000
BRAIN_TEMPERATURE=0.7

# 传输层重试（429 限流 / 5xx / 超时 / 连接抖动才重试；400 协议错、401 key 错一次都不多撞）
# 免费额度撞 429 是常态，这三个值按账号额度调，别写死在代码里。
# 单次等待上限：服务端 Retry-After 超过它就夹到上限后失败，不挂死把 wall 预算烧光。
BRAIN_MAX_RETRIES=3
BRAIN_BACKOFF_MS=1000
BRAIN_MAX_BACKOFF_MS=15000